17:["$","div",null,{"className":"prose prose-lg max-w-none","children":[["$","p",null,{"className":"text-gray-700 leading-relaxed mb-6","children":"No hay una respuesta única a esta pregunta. Lo que conviene vender depende de lo que sabés hacer, del capital que tenés para empezar y de lo que el mercado argentino está buscando. Pero sí hay tendencias claras que te pueden ayudar a arrancar por el buen camino."}],["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mt-10 mb-6","children":"Rubros con más demanda en 2026"}],["$","div",null,{"className":"space-y-4 mb-10","children":[["$","div","0",{"className":"border rounded-xl p-5 bg-blue-50 border-blue-200","children":[["$","div",null,{"className":"flex items-start justify-between mb-2","children":[["$","h3",null,{"className":"font-bold text-gray-900","children":"Ropa y accesorios"}],["$","span",null,{"className":"text-xs bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-600 ml-4 shrink-0","children":"Muy alta"}]]}],["$","p",null,{"className":"text-sm text-gray-600 mb-1","children":[["$","span",null,{"className":"font-medium","children":"Competencia:"}]," ","Alta"]}],["$","p",null,{"className":"text-sm text-gray-700","children":"Si tenés marca propia o revendés ropa con alguna diferenciación"}]]}],["$","div","1",{"className":"border rounded-xl p-5 bg-green-50 border-green-200","children":[["$","div",null,{"className":"flex items-start justify-between mb-2","children":[["$","h3",null,{"className":"font-bold text-gray-900","children":"Artesanías y productos hechos a mano"}],["$","span",null,{"className":"text-xs bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-600 ml-4 shrink-0","children":"Alta"}]]}],["$","p",null,{"className":"text-sm text-gray-600 mb-1","children":[["$","span",null,{"className":"font-medium","children":"Competencia:"}]," ","Media"]}],["$","p",null,{"className":"text-sm text-gray-700","children":"Si fabricás vos mismo. Buen margen y clientes fieles"}]]}],["$","di