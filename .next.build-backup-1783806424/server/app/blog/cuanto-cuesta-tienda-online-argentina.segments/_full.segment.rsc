24:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"tol.ar"}],": $0 extra → costo total: $38.050"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Plataforma con comisión (plan gratis)"}],": 2% de $500.000 = $10.000 extra → costo total: $48.050"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Plataforma con comisión (plan pago)"}],": ~$15.000 de mensualidad → costo total: $53.050"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Shopify Basic"}],": 2% de $500.000 + USD 29 de mensualidad ≈ $10.000 + ~$38.000 extra → costo total mucho más alto"]}]]}]
