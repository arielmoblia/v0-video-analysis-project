11:["$","ol",null,{"children":[["$","li",null,{"children":"Tenés tu tienda online donde el cliente puede ver y comprar 24 horas"}],["$","li",null,{"children":"En la tienda hay un botón de WhatsApp para consultas específicas"}],["$","li",null,{"children":"Los pedidos que vienen por la tienda se procesan solos (el cliente paga, vos recibís el aviso)"}],["$","li",null,{"children":"Los que escriben por WhatsApp primero los dirigís a la tienda cuando están listos para comprar"}]]}]
