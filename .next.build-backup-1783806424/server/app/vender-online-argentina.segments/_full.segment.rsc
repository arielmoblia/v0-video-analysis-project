16:["$","p",null,{"children":"Vender online no cambia las reglas de AFIP: si superás los límites de tu categoría de monotributo o facturás sin estar inscripto, hay consecuencias. Vale la pena revisarlo antes de escalar el negocio."}]
17:["$","p",null,{"children":["$","$L11",null,{"href":"/blog/vender-online-monotributista-argentina","children":"Ver la guía completa para monotributistas →"}]}]
