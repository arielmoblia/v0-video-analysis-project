ntro de otra plataforma."}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]}],"$L1e"]}],"$L1f"],["$L20"],"$L21"]}]
